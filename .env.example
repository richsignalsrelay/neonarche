# Postgres connection string used by the collector and dashboard API (COLL-001, DASH-003)
DB_URL=postgresql://localhost:5432/one_pane

# Playwright producer (PW-001/PW-002) — defaults match `npm run fixture:serve`
PW_TARGET_URL=http://localhost:8080
PW_TEST_USER=test@example.com
PW_TEST_PASSWORD=test-password

# Synthetics canary (SYN-001, stubbed locally — no real AWS yet). Optional, defaults to eu-west-1.
SYN_REGION=eu-west-1
